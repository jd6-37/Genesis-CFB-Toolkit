{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/toolkit",
      "destination": "/app"
    },
    {
      "source": "/dynasty",
      "destination": "/app"
    },
    {
      "source": "/dynasty/s/:id",
      "destination": "/app"
    },
    {
      "source": "/dynasty/sample",
      "destination": "/app"
    }
  ],
  "crons": [
    {
      "path": "/api/snapshot?cleanup=1",
      "schedule": "17 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
